# --- Relay access controls ---
INTERNAL_API_TOKEN=generate-a-long-random-secret
MCP_API_TOKEN=generate-a-different-long-random-secret
MCP_MAX_VOLUME=70
MCP_ALLOWED_ORIGINS=
DASHBOARD_TOKEN=
DASHBOARD_SESSION_HOURS=12

# Optional Sonos fallback. Leave blank for SSDP auto-discovery.
SONOS_SEED_IP=

# --- Node relay (nas-relay) ---
LOG_LEVEL=info
RELAY_PORT=8787
DATA_DIR=/app/data

APNS_BUNDLE_ID=com.charm.SonosWidget
APNS_KEY_PATH=/app/data/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=3MSS7DJGVR
APNS_PRODUCTION=false
