# Copy to .env and fill in the values you have.

# Image to pull. Pick one published registry.
#
# Docker Hub example:
# NAS_RELAY_IMAGE=docker.io/your-dockerhub-user/nas-relay:latest
#
# Aliyun example:
# NAS_RELAY_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/nas-relay:latest
#
# Forgejo/private registry example:
# NAS_RELAY_IMAGE=forgejo.charmmmz.xyz/charm/charm-for-sonos/nas-relay:latest
NAS_RELAY_IMAGE=docker.io/your-dockerhub-user/nas-relay:latest

# Pull policy for deployment. Keep `always` for NAS/Portainer stacks that track
# the latest published image.
NAS_RELAY_PULL_POLICY=always

# Production relay container name on the NAS.
NAS_RELAY_CONTAINER_NAME=sonos-live-activity-relay

# Production relay host path mounted to /app/data. Use an absolute NAS path.
# Examples:
# NAS_RELAY_DATA_DIR=/share/Data/nas-relay/data
# NAS_RELAY_DATA_DIR=/volume1/docker/nas-relay/data
NAS_RELAY_DATA_DIR=./data

# Debug relay runs beside production with isolated APNs token state.
NAS_RELAY_DEBUG_CONTAINER_NAME=sonos-live-activity-relay-debug
NAS_RELAY_DEBUG_DATA_DIR=./data-debug

# Logging — info | debug | warn | error
LOG_LEVEL=info

# Production relay HTTP listen port (TestFlight/App Store).
RELAY_PORT=8787

# Debug relay HTTP listen port (Xcode-installed builds). Avoid 8788 because
# that port is often used by the Hue sidecar on the NAS.
DEBUG_RELAY_PORT=8789

# Persistent data directory inside the container. Stores tokens.json, apns.p8,
# and the Hue Music Ambience config uploaded by the iOS app.
DATA_DIR=/app/data

# Shared secret for /internal/* (Python agent). Generate a long random string.
# If unset, internal routes return 503.
INTERNAL_API_TOKEN=

# LAN-only MCP endpoint at /mcp. Generate a separate long random token.
# If unset, /mcp returns 503 and no MCP tools can be called.
MCP_API_TOKEN=
# Hard safety ceiling for agent-issued volume changes.
MCP_MAX_VOLUME=70
# Browser-based MCP clients must send an exact Origin from this comma-separated
# allowlist. Normal desktop/CLI MCP clients do not send Origin and need no entry.
MCP_ALLOWED_ORIGINS=

# LAN web console at /dashboard/. If blank, it reuses MCP_API_TOKEN.
DASHBOARD_TOKEN=
# Login cookie lifetime, clamped to 1–168 hours.
DASHBOARD_SESSION_HOURS=12
# Leave false for normal HTTP LAN access; enable only behind HTTPS.
DASHBOARD_SECURE_COOKIE=false

# Optional fallback. Leave blank for SSDP auto-discovery.
# Set this only if multicast discovery does not work on your LAN/VLAN.
SONOS_SEED_IP=

# Hue Music Ambience — iOS uploads Bridge credentials and assignments here.
HUE_AMBIENCE_ENABLED=true
HUE_AMBIENCE_CONFIG_PATH=/app/data/hue-ambience-config.json
# Optional NAS override for Light Motion Speed. Leave blank to use the iOS app
# setting. Lower values move faster; examples: 8, 6, 4.
HUE_FLOW_INTERVAL_SECONDS=

# APNs — bundle/team defaults match Charm for Sonos. Leave KEY_ID blank until
# you place the Apple Developer .p8 key at APNS_KEY_PATH.
# When KEY_ID or the key file is missing, the relay runs in dry-run mode.
APNS_BUNDLE_ID=com.charm.SonosWidget
APNS_KEY_PATH=/app/data/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=3MSS7DJGVR
# Primary relay is for TestFlight/App Store production APNs.
APNS_PRODUCTION=true

# Debug relay is for Xcode debug/sandbox APNs. It reuses APNS_KEY_PATH,
# APNS_KEY_ID, APNS_TEAM_ID, and APNS_BUNDLE_ID unless overridden below.
DEBUG_APNS_PRODUCTION=false
# DEBUG_APNS_KEY_PATH=/app/data/apns.p8
# DEBUG_APNS_KEY_ID=
# DEBUG_APNS_TEAM_ID=3MSS7DJGVR
# DEBUG_APNS_BUNDLE_ID=com.charm.SonosWidget
